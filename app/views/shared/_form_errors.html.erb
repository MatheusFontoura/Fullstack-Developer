<% if model.errors.any? %>
  <div class="mb-5 rounded-lg bg-red-50 px-4 py-3 ring-1 ring-inset ring-red-200" role="alert">
    <p class="text-sm font-medium text-red-800">
      <%= pluralize(model.errors.count, "error") %> prevented this from being saved:
    </p>
    <ul class="mt-2 list-inside list-disc text-sm text-red-700">
      <% model.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
