<% if page.previous? || page.next? %>
  <nav class="mt-6 flex items-center justify-between" aria-label="Pagination">
    <% if page.previous? %>
      <%= link_to "← Previous", url_for(filters.merge(page: page.number - 1)), class: "btn-secondary" %>
    <% else %>
      <span></span>
    <% end %>

    <span class="text-sm text-slate-500">Page <%= page.number %></span>

    <% if page.next? %>
      <%= link_to "Next →", url_for(filters.merge(page: page.number + 1)), class: "btn-secondary" %>
    <% else %>
      <span></span>
    <% end %>
  </nav>
<% end %>
