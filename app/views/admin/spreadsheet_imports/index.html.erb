<% content_for :title, "Imports" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight">Imports</h1>
    <p class="mt-1 text-sm text-slate-500">Spreadsheets uploaded to create users.</p>
  </div>

  <%= link_to "New import", new_admin_spreadsheet_import_path, class: "btn-primary" %>
</div>

<div class="card table-scroll mt-6">
  <table class="block min-w-full divide-y divide-slate-200 text-left sm:table">
    <thead class="hidden bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500 sm:table-header-group">
      <tr>
        <th scope="col" class="px-4 py-3">File</th>
        <th scope="col" class="px-4 py-3">Status</th>
        <th scope="col" class="px-4 py-3">Rows</th>
        <th scope="col" class="hidden px-4 py-3 md:table-cell">Uploaded by</th>
        <th scope="col" class="hidden px-4 py-3 text-right whitespace-nowrap sm:table-cell">Started</th>
      </tr>
    </thead>

    <tbody class="block divide-y divide-slate-100 sm:table-row-group">
      <% if @spreadsheet_imports.any? %>
        <% @spreadsheet_imports.each do |spreadsheet_import| %>
          <tr class="flex flex-wrap items-center gap-y-2 py-2 hover:bg-slate-50 sm:table-row sm:gap-0 sm:py-0">
            <td class="w-full px-4 pt-2 whitespace-nowrap sm:w-auto sm:table-cell sm:py-3">
              <%= link_to spreadsheet_import.file.filename,
                    admin_spreadsheet_import_path(spreadsheet_import),
                    class: "font-medium text-brand-600 hover:text-brand-700" %>
            </td>
            <td class="px-4 pb-2 sm:table-cell sm:py-3">
              <span class="<%= import_status_badge(spreadsheet_import) %>">
                <%= spreadsheet_import.status.capitalize %>
              </span>
            </td>
            <td class="ml-auto px-4 pb-2 text-sm whitespace-nowrap tabular-nums text-slate-600 sm:ml-0 sm:table-cell sm:py-3">
              <%= spreadsheet_import.imported_rows %> imported<%= ", #{spreadsheet_import.failed_rows} rejected" if spreadsheet_import.failed_rows.positive? %>
            </td>
            <td class="hidden px-4 py-3 text-sm text-slate-500 md:table-cell">
              <%= spreadsheet_import.user.full_name %>
            </td>
            <td class="hidden px-4 py-3 text-right text-sm whitespace-nowrap text-slate-500 sm:table-cell">
              <%= time_ago_in_words(spreadsheet_import.created_at) %> ago
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr class="block sm:table-row">
          <td colspan="5" class="block px-4 py-10 text-center text-sm text-slate-500 sm:table-cell">
            No imports yet.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
