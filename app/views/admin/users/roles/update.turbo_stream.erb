<%# Only the changed row and the flash are sent back, so the admin's scroll position,
    search term and page stay exactly where they were. %>
<%= turbo_stream.replace dom_id(@user) do %>
  <%= render "admin/users/user", user: @user %>
<% end %>

<%= turbo_stream.replace "flash" do %>
  <%= render "shared/flash" %>
<% end %>
